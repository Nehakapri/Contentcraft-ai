# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" or share your real API key.

# Get a key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Model name. Models are retired over time, so check Google's current model list if you see "model not found".
GEMINI_MODEL=gemini-3.1-flash-lite

AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=45

# Max AI requests per minute per user (protects your free quota)
RATE_LIMIT_PER_MINUTE=10
MAX_INPUT_CHARS=6000

# 1 = auto-reload and detailed errors (good while developing). Use 0 for any public deployment.
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000